@page "/sensors"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SensorApiService SensorService

<h3>Sensor Registration</h3>

<div class="mb-3">
    <label>Sensor Name</label>
    <input class="form-control" @bind="newSensor.SensorName" />
</div>

<div class="mb-3">
    <label>Device Identifier</label>
    <input class="form-control" @bind="newSensor.DeviceIdentifier" />
</div>

<div class="mb-3">
    <label>Deployment Location</label>
    <select class="form-control" @bind="newSensor.DeploymentLocation">
        <option value="">Select a location</option>
        <option>Greenhouse 1</option>
        <option>Greenhouse 2</option>
        <option>Warehouse</option>
        <option>Server Room</option>
        <option>Main Office</option>
    </select>
</div>

<div class="mb-3">
    <label>Category</label>
    <select class="form-control" @bind="newSensor.Category">
        <option value="">Select a category</option>
        <option>Temperature</option>
        <option>Humidity</option>
        <option>Power</option>
        <option>Switch</option>
    </select>
</div>

<button class="btn btn-primary" @onclick="RegisterSensor">
    Register Sensor
</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

<hr />

<h4>Registered Sensors</h4>

@if (sensors.Count == 0)
{
    <p>No sensors have been registered yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Sensor Name</th>
                <th>Device</th>
                <th>Location</th>
                <th>Category</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sensor in sensors)
            {
                <tr>
                    <td>@sensor.Id</td>
                    <td>@sensor.SensorName</td>
                    <td>@sensor.DeviceIdentifier</td>
                    <td>@sensor.DeploymentLocation</td>
                    <td>@sensor.Category</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private SensorRegistration newSensor = new();
    private List<SensorRegistration> sensors = new();
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        sensors = await SensorService.GetSensorsAsync();
    }

    private async Task RegisterSensor()
    {
        var result = await SensorService.AddSensorAsync(newSensor);

        if (result == null)
        {
            message = "Sensor registration failed.";
            return;
        }

        message = "Sensor registered successfully.";
        sensors.Add(result);

        // Clears the form after the sensor is added.
        newSensor = new SensorRegistration();
    }
}