@page "/dashboard"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using SmartX.Client.Models
@using SmartX.Client.Services
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject SensorApiService SensorApi

<div class="dashboard-shell">
    <div class="dashboard-heading">
        <div>
            <h3>Smart-X Dashboard</h3>
            <p>
                Monitor sensor activity, live temperature readings
                and alerts from registered devices.
            </p>
        </div>

        <span class="live-indicator">
            <span class="live-dot"></span>
            Auto-refresh enabled
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(connectionMessage))
    {
        <div class="alert alert-warning">
            @connectionMessage
        </div>
    }

    @if (sensors.Count == 0)
    {
        <div class="alert alert-info">
            No registered sensors were found.
            Upload a sensor text file from the Files page first.
        </div>
    }

    <div class="dashboard-metrics">
        <div class="metric-card">
            <span class="metric-label">Registered Sensors</span>
            <strong class="metric-number">@sensors.Count</strong>
            <span class="metric-description">Available devices</span>
        </div>

        <div class="metric-card">
            <span class="metric-label">Latest Temperature</span>

            <strong class="metric-number">
                @if (latestReading is not null)
                {
                    @latestReading.Value.ToString(
                        "0.0",
                        CultureInfo.InvariantCulture)
                    <span> °C</span>
                }
                else
                {
                    <span>--</span>
                }
            </strong>

            <span class="metric-description">
                @if (latestReading is not null)
                {
                    @GetSensorName(latestReading.DeviceIdentifier)
                }
                else
                {
                    <span>Waiting for telemetry</span>
                }
            </span>
        </div>

        <div class="metric-card">
            <span class="metric-label">Latest Status</span>

            @if (latestReading is not null)
            {
                <strong class="@GetStatusClass(latestReading.Value)">
                    @GetSeverity(latestReading.Value)
                </strong>

                <span class="metric-description">
                    @GetStatusDescription(latestReading.Value)
                </span>
            }
            else
            {
                <strong class="status-pill status-unknown">
                    NO DATA
                </strong>

                <span class="metric-description">
                    No readings received yet
                </span>
            }
        </div>

        <div class="metric-card">
            <span class="metric-label">Recent Readings</span>
            <strong class="metric-number">@readings.Count</strong>
            <span class="metric-description">
                Latest @MaximumChartReadings retained for display
            </span>
        </div>
    </div>

    <section class="dashboard-panel">
        <div class="panel-heading">
            <div>
                <h4>Temperature History</h4>
                <p>Recent readings from the API, updated automatically.</p>
            </div>

            @if (lastUpdated.HasValue)
            {
                <span class="refresh-time">
                    Updated @lastUpdated.Value.ToString("HH:mm:ss")
                </span>
            }
        </div>

        @if (readings.Count == 0)
        {
            <div class="empty-state">
                <h5>Waiting for temperature readings</h5>
                <p>
                    Submit a simulated reading below or send a reading
                    to the API from a registered device.
                </p>
            </div>
        }
        else
        {
            <div class="temperature-chart">
                @foreach (var reading in readings.TakeLast(MaximumChartReadings))
                {
                    <div class="chart-column"
                         title="@GetReadingTooltip(reading)">

                        <div class="chart-bar-wrap">
                            <div class="@GetBarClass(reading.Value)"
                                 style="@($"height: {GetBarHeight(reading.Value)};")">
                            </div>
                        </div>

                        <span class="chart-value">
                            @reading.Value.ToString(
                                "0.0",
                                CultureInfo.InvariantCulture)
                        </span>

                        <span class="chart-time">
                            @reading.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </span>
                    </div>
                }
            </div>

            <div class="chart-legend">
                <span><i class="legend-dot normal"></i> Normal</span>
                <span><i class="legend-dot warning"></i> Warning</span>
                <span><i class="legend-dot critical"></i> Critical</span>
            </div>
        }
    </section>

    <section class="dashboard-panel">
        <div class="panel-heading">
            <div>
                <h4>Simulate a Temperature Reading</h4>
                <p>
                    Submit a reading through the API so it is recorded
                    in history and checked against alert thresholds.
                </p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="sensorSelect">
                    Registered Sensor
                </label>

                <select id="sensorSelect"
                        class="form-select"
                        @bind="selectedDeviceIdentifier"
                        disabled="@(sensors.Count == 0 || isSubmitting)">
                    @foreach (var sensor in sensors)
                    {
                        <option value="@sensor.DeviceIdentifier">
                            @sensor.SensorName (@sensor.DeviceIdentifier)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="temperatureInput">
                    Temperature in °C
                </label>

                <input id="temperatureInput"
                       class="form-control"
                       type="number"
                       step="0.1"
                       @bind="temperatureReading"
                       disabled="@isSubmitting" />
            </div>
        </div>

        <button class="btn btn-primary mt-3"
                @onclick="SubmitReadingAsync"
                disabled="@(isSubmitting || sensors.Count == 0)">
            @(isSubmitting ? "Sending Reading..." : "Send Reading to API")
        </button>

        @if (!string.IsNullOrWhiteSpace(actionMessage))
        {
            <div class="alert @(actionSucceeded ? "alert-success" : "alert-warning") mt-3 mb-0">
                @actionMessage
            </div>
        }
    </section>

    <section class="dashboard-panel">
        <div class="panel-heading">
            <div>
                <h4>Recent Telemetry</h4>
                <p>Device details and statuses for the latest readings.</p>
            </div>
        </div>

        @if (readings.Count == 0)
        {
            <p class="empty-state">
                No telemetry is available yet.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Temperature</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reading in readings.AsEnumerable().Reverse().Take(10))
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @GetSensorName(reading.DeviceIdentifier)
                                    </strong>
                                    <div class="device-id">
                                        @reading.DeviceIdentifier
                                    </div>
                                </td>

                                <td>
                                    @reading.Value.ToString(
                                        "0.0",
                                        CultureInfo.InvariantCulture) °C
                                </td>

                                <td>
                                    <span class="@GetStatusClass(reading.Value)">
                                        @GetSeverity(reading.Value)
                                    </span>
                                </td>

                                <td>
                                    @reading.Timestamp.ToLocalTime().ToString(
                                        "yyyy-MM-dd HH:mm:ss")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<style>
    .dashboard-shell {
        max-width: 1400px;
        margin: 0 auto;
        padding: 12px 0 30px;
    }

    .dashboard-heading,
    .panel-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .dashboard-heading {
        margin-bottom: 24px;
    }

        .dashboard-heading h3,
        .panel-heading h4 {
            margin-bottom: 6px;
        }

        .dashboard-heading p,
        .panel-heading p {
            color: #64748b;
            margin-bottom: 0;
        }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #166534;
        font-size: 0.9rem;
        white-space: nowrap;
    }

    .live-dot,
    .legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
    }

    .live-dot {
        background: #16a34a;
    }

    .dashboard-metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .metric-card,
    .dashboard-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .metric-card {
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        min-width: 0;
    }

    .metric-label,
    .metric-description {
        color: #64748b;
        font-size: 0.9rem;
    }

    .metric-number {
        color: #0f172a;
        font-size: 1.8rem;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .dashboard-panel {
        padding: 22px;
        margin-bottom: 20px;
    }

    .panel-heading {
        margin-bottom: 20px;
    }

    .refresh-time {
        color: #64748b;
        font-size: 0.85rem;
    }

    .status-pill {
        display: inline-block;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    .status-normal {
        color: #166534;
        background: #dcfce7;
    }

    .status-warning {
        color: #92400e;
        background: #fef3c7;
    }

    .status-critical {
        color: #991b1b;
        background: #fee2e2;
    }

    .status-unknown {
        color: #475569;
        background: #e2e8f0;
    }

    .temperature-chart {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        min-height: 210px;
        overflow-x: auto;
        padding: 12px 4px 0;
    }

    .chart-column {
        min-width: 42px;
        flex: 1 0 42px;
        max-width: 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .chart-bar-wrap {
        width: 100%;
        height: 150px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        border-bottom: 1px solid #cbd5e1;
        background: linear-gradient(to top, #f8fafc, #fff);
    }

    .chart-bar {
        width: 70%;
        min-height: 4px;
        border-radius: 5px 5px 0 0;
        transition: height 0.3s ease;
    }

        .chart-bar.normal {
            background: #22c55e;
        }

        .chart-bar.warning {
            background: #f59e0b;
        }

        .chart-bar.critical {
            background: #ef4444;
        }

    .chart-value {
        font-size: 0.8rem;
