    @@media (max-width: 520px) {
        .dashboard-metrics {
            grid-template-columns: 1fr;
        }

        .dashboard-panel {
            padding: 15px;
        }
    }
</style>

@code {
    private const int MaximumChartReadings = 20;

    private readonly CancellationTokenSource _refreshCancellation = new();

    private Task? _refreshTask;

    private List<SensorRegistration> sensors = new();
    private List<LiveTelemetryReading> readings = new();

    private string selectedDeviceIdentifier = string.Empty;
    private double temperatureReading = 22.0;

    private string connectionMessage = string.Empty;
    private string actionMessage = string.Empty;

    private bool actionSucceeded;
    private bool isSubmitting;

    private DateTime? lastUpdated;

    private LiveTelemetryReading? latestReading =>
        readings.LastOrDefault();

    protected override async Task OnInitializedAsync()
    {
        // Load the initial dashboard data before starting automatic refresh.
        await RefreshDashboardAsync();

        // Refresh the dashboard every three seconds while the page is open.
        _refreshTask = RefreshLoopAsync(_refreshCancellation.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshDashboardAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // The page is closing, so stop the refresh loop.
        }
    }

    private async Task RefreshDashboardAsync()
    {
        try
        {
            // Refresh the registered device list.
            var loadedSensors = await SensorApi.GetSensorsAsync();

            sensors = loadedSensors?.ToList() ?? new List<SensorRegistration>();

            // Keep the selected device valid when the sensor list changes.
            if (!sensors.Any(sensor =>
                string.Equals(
                    sensor.DeviceIdentifier,
                    selectedDeviceIdentifier,
                    StringComparison.OrdinalIgnoreCase)))
            {
                selectedDeviceIdentifier =
                    sensors.FirstOrDefault()?.DeviceIdentifier ?? string.Empty;
            }

            // Retrieve recent readings with their source device identifiers.
            var loadedReadings =
                await Http.GetFromJsonAsync<List<LiveTelemetryReading>>(
                    "api/Telemetry/live/readings");

            readings = loadedReadings ?? new List<LiveTelemetryReading>();

            lastUpdated = DateTime.Now;
            connectionMessage = string.Empty;
        }
        catch (HttpRequestException)
        {
            connectionMessage =
                "Could not connect to the API. Make sure SmartX.Api is running and you are signed in.";
        }
        catch (JsonException)
        {
            connectionMessage =
                "The API returned data that the dashboard could not read.";
        }
        catch (TaskCanceledException)
        {
            connectionMessage =
                "The dashboard request took too long. It will try again automatically.";
        }
    }

    private async Task SubmitReadingAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedDeviceIdentifier))
        {
            actionSucceeded = false;
            actionMessage =
                "Register a sensor before submitting a temperature reading.";
            return;
        }

        if (!double.IsFinite(temperatureReading))
        {
            actionSucceeded = false;
            actionMessage = "Enter a valid temperature value.";
            return;
        }

        isSubmitting = true;
        actionMessage = string.Empty;

        try
        {
            // Use invariant formatting so the API receives a decimal point.
            var url =
                "api/Telemetry/temperature" +
                $"?deviceIdentifier={Uri.EscapeDataString(selectedDeviceIdentifier)}" +
                $"&value={temperatureReading.ToString(CultureInfo.InvariantCulture)}";

            // The API records the reading, queues it and checks its alert level.
            using var response = await Http.PostAsync(url, content: null);

            if (response.IsSuccessStatusCode)
            {
                actionSucceeded = true;
                actionMessage =
                    "Reading sent successfully. The dashboard will update automatically.";

                await RefreshDashboardAsync();
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.Unauthorized)
            {
                actionSucceeded = false;
                actionMessage =
                    "Your session may have expired. Please sign in again.";
            }
            else
            {
                actionSucceeded = false;
                actionMessage =
                    $"The API rejected the reading. Status code: {(int)response.StatusCode}.";
            }
        }
        catch (HttpRequestException)
        {
            actionSucceeded = false;
            actionMessage =
                "Could not send the reading. Check that the API is running.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetSensorName(string deviceIdentifier)
    {
        return sensors.FirstOrDefault(sensor =>
                   string.Equals(
                       sensor.DeviceIdentifier,
                       deviceIdentifier,
                       StringComparison.OrdinalIgnoreCase))
                   ?.SensorName
               ?? deviceIdentifier;
    }

    private static string GetSeverity(double value)
    {
        if (value < 10 || value > 40)
        {
            return "CRITICAL";
        }

        if (value < 15 || value > 35)
        {
            return "WARNING";
        }

        return "NORMAL";
    }

    private static string GetStatusDescription(double value)
    {
        return GetSeverity(value) switch
        {
            "CRITICAL" => "Outside the safe operating range",
            "WARNING" => "Temperature needs attention",
            _ => "Within the expected range"
        };
    }

    private static string GetStatusClass(double value)
    {
        return GetSeverity(value) switch
        {
            "CRITICAL" => "status-pill status-critical",
            "WARNING" => "status-pill status-warning",
            _ => "status-pill status-normal"
        };
    }

    private static string GetBarClass(double value)
    {
        return GetSeverity(value) switch
        {
            "CRITICAL" => "chart-bar critical",
            "WARNING" => "chart-bar warning",
            _ => "chart-bar normal"
        };
    }

    private static string GetBarHeight(double value)
    {
        // Map temperatures to a 0-50 degree chart scale.
        var boundedValue = Math.Clamp(value, 0, 50);
        var percentage = Math.Max(4, boundedValue / 50 * 100);

        return percentage.ToString("0.0", CultureInfo.InvariantCulture) + "%";
    }

    private string GetReadingTooltip(LiveTelemetryReading reading)
    {
        return $"{GetSensorName(reading.DeviceIdentifier)}: " +
               $"{reading.Value.ToString("0.0", CultureInfo.InvariantCulture)} °C " +
               $"at {reading.Timestamp.ToLocalTime():HH:mm:ss}";
    }

    public async ValueTask DisposeAsync()
    {
        _refreshCancellation.Cancel();

        if (_refreshTask is not null)
        {
            try
            {
                await _refreshTask;
            }
            catch (OperationCanceledException)
            {
                // Expected when the dashboard is closed.
            }
        }

        _refreshCancellation.Dispose();
    }

    // Represents one reading returned by the live telemetry API.
    private sealed class LiveTelemetryReading
    {
        public string DeviceIdentifier { get; set; } = string.Empty;

        public double Value { get; set; }

        public DateTime Timestamp { get; set; }
    }
}
