@page "/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.JSInterop
@inject SmartX.Client.Services.FirebaseAuthService AuthService
@inject SmartX.Client.Services.FirebaseAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Create Account - Smart-X</PageTitle>

<div class="container py-5" style="min-height: 75vh; display: flex; align-items: center;">
    <div class="row justify-content-center w-100">
        <div class="col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <span class="badge rounded-pill text-bg-primary px-3 py-2">
                                SMART-X IOT MANAGEMENT
                            </span>
                        </div>

                        <h1 class="h3 fw-bold">Create your account</h1>

                        <p class="text-secondary">
                            Register to manage your connected IoT devices.
                        </p>
                    </div>

                    <EditForm Model="@form" OnValidSubmit="@RegisterAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small" />

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                Email address
                            </label>

                            <InputText id="email"
                                       class="form-control form-control-lg"
                                       type="email"
                                       autocomplete="email"
                                       placeholder="you@example.com"
                                       @bind-Value="form.Email" />

                            <ValidationMessage For="@(() => form.Email)"
                                               class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                Password
                            </label>

                            <InputText id="password"
                                       class="form-control form-control-lg"
                                       type="password"
                                       autocomplete="new-password"
                                       placeholder="At least 6 characters"
                                       @bind-Value="form.Password" />

                            <ValidationMessage For="@(() => form.Password)"
                                               class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">
                                Confirm password
                            </label>

                            <InputText id="confirmPassword"
                                       class="form-control form-control-lg"
                                       type="password"
                                       autocomplete="new-password"
                                       placeholder="Enter your password again"
                                       @bind-Value="form.ConfirmPassword" />

                            <ValidationMessage For="@(() => form.ConfirmPassword)"
                                               class="text-danger small" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @errorMessage
                            </div>
                        }

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 mt-2"
                                disabled="@isBusy">
                            @(isBusy ? "Creating account..." : "Create Account")
                        </button>
                    </EditForm>

                    <div class="text-center mt-4">
                        <span class="text-secondary">
                            Already registered?
                        </span>

                        <a href="/login"
                           class="fw-semibold text-decoration-none">
                            Sign in
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterForm form = new();
    private bool isBusy;
    private string? errorMessage;

    private async Task RegisterAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            // Create the account through Firebase.
            await AuthService.RegisterAsync(
                form.Email.Trim(),
                form.Password);

            // Tell Blazor that the new user is signed in.
            await AuthStateProvider.RefreshAuthenticationStateAsync();

            // Return to the application's home page.
            Navigation.NavigateTo("/");
        }
        catch (JSException ex)
        {
            errorMessage = GetFriendlyError(ex.Message);
        }
        catch
        {
            errorMessage = "Unable to create your account. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string GetFriendlyError(string message)
    {
        if (message.Contains("auth/email-already-in-use",
                StringComparison.OrdinalIgnoreCase))
        {
            return "An account with this email already exists. Please sign in.";
        }

        if (message.Contains("auth/invalid-email",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Please enter a valid email address.";
        }

        if (message.Contains("auth/weak-password",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Please choose a stronger password with at least 6 characters.";
        }

        if (message.Contains("auth/operation-not-allowed",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Email and password sign-in is not enabled in Firebase.";
        }

        if (message.Contains("auth/network-request-failed",
                StringComparison.OrdinalIgnoreCase))
        {
            return "A network error occurred. Check your connection.";
        }

        return "Registration failed. Please check your details and try again.";
    }

    private class RegisterForm
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
