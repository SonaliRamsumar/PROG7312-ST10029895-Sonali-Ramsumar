@page "/files"
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@attribute [Authorize]
@inject HttpClient Http

<h3>Sensor File Upload</h3>

<p>
    Upload a configuration file, log file or deployment image.
    Text files containing sensor details will be processed automatically.
</p>

<p>
    For device registration, use a .txt file with four fields:
    Device Identifier, Sensor Name, Deployment Location and Category.
</p>

<InputFile OnChange="HandleFileSelected"
           accept=".txt,.log,.json,.pdf,.png,.jpg,.jpeg" />

@if (selectedFile != null)
{
    <p class="mt-2">
        Selected file: @selectedFile.Name
    </p>

    <button class="btn btn-primary"
            @onclick="UploadFile"
            disabled="@isUploading">
        @(isUploading ? "Uploading..." : "Upload File")
    </button>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

@if (uploadResult != null && uploadResult.RegisteredSensors.Count > 0)
{
    <h4 class="mt-4">Registered Devices</h4>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Device ID</th>
                    <th>Sensor Name</th>
                    <th>Deployment Location</th>
                    <th>Category</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sensor in uploadResult.RegisteredSensors)
                {
                    <tr>
                        <td>@sensor.DeviceIdentifier</td>
                        <td>@sensor.SensorName</td>
                        <td>@sensor.DeploymentLocation</td>
                        <td>@sensor.Category</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (uploadResult != null && uploadResult.Errors.Count > 0)
{
    <h4 class="mt-4">Rows Not Registered</h4>

    <ul>
        @foreach (var error in uploadResult.Errors)
        {
            <li>@error</li>
        }
    </ul>
}

@code {
    private IBrowserFile? selectedFile;
    private string message = string.Empty;
    private bool isUploading;

    private UploadResult? uploadResult;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        message = string.Empty;
        uploadResult = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null)
        {
            message = "Please select a file first.";
            return;
        }

        isUploading = true;
        message = string.Empty;
        uploadResult = null;

        try
        {
            using var content = new MultipartFormDataContent();

            // Read the selected file with a 10 MB limit.
            using var fileContent = new StreamContent(
                selectedFile.OpenReadStream(
                    maxAllowedSize: 10 * 1024 * 1024));

            content.Add(
                fileContent,
                "file",
                selectedFile.Name);

            var response = await Http.PostAsync(
                "api/Files/upload",
                content);

            if (response.IsSuccessStatusCode)
            {
                uploadResult =
                    await response.Content.ReadFromJsonAsync<UploadResult>();

                message = uploadResult?.Message
                    ?? "File uploaded successfully.";

                selectedFile = null;
            }
            else
            {
                var errorResult =
                    await response.Content.ReadFromJsonAsync<ErrorResult>();

                message = errorResult?.Message
                    ?? "File upload failed. Please check the file and try again.";
            }
        }
        catch (HttpRequestException)
        {
            message = "Could not connect to the API. Make sure SmartX.Api is running.";
        }
        catch (IOException)
        {
            message = "The file could not be read. Please select it again.";
        }
        catch (InvalidOperationException)
        {
            message = "The file could not be uploaded. Please select a smaller file.";
        }
        finally
        {
            isUploading = false;
        }
    }

    // These classes represent the response returned by FilesController.
    private sealed class UploadResult
    {
        public string Message { get; set; } = string.Empty;

        public string FileName { get; set; } = string.Empty;

        public List<UploadedSensor> RegisteredSensors { get; set; } = new();

        public List<string> Errors { get; set; } = new();

        public int SkippedLines { get; set; }
    }

    private sealed class UploadedSensor
    {
        public int Id { get; set; }

        public string DeviceIdentifier { get; set; } = string.Empty;

        public string SensorName { get; set; } = string.Empty;

        public string DeploymentLocation { get; set; } = string.Empty;

        public string Category { get; set; } = string.Empty;
    }

    private sealed class ErrorResult
    {
        public string Message { get; set; } = string.Empty;
    }
}
