@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Smart-X</PageTitle>

<div class="container mt-5 text-center">
    <h3>Smart-X IoT Management System</h3>
    <p>Checking your sign-in status...</p>
</div>

@code {
    private bool hasRedirected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Check the login status once the page has rendered.
        if (!firstRender || hasRedirected)
        {
            return;
        }

        hasRedirected = true;

        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        // Send authenticated users to the Dashboard.
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/dashboard", replace: true);
        }
        else
        {
            // Users without a valid login session must sign in.
            Navigation.NavigateTo("/login", replace: true);
        }
    }
}
