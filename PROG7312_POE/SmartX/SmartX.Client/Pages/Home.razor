@page "/"

<h1>Smart-X IoT Management System</h1>

<p>
    Smart-X is used to register, monitor and manage IoT sensors from one dashboard.
</p>

<div class="row mt-4">

    <div class="col-md-4 mb-3">
        <div class="card p-3 h-100">
            <h4>Sensor Management</h4>
            <p>
                Register sensors and view their device identifier, location and category.
            </p>
            <a class="btn btn-primary" href="sensors">
                Manage Sensors
            </a>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card p-3 h-100">
            <h4>Telemetry Dashboard</h4>
            <p>
                Monitor simulated sensor readings and identify warning or critical values.
            </p>
            <a class="btn btn-primary" href="dashboard">
                Open Dashboard
            </a>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card p-3 h-100">
            <h4>Sensor Files</h4>
            <p>
                Upload sensor logs, configuration files and deployment images.
            </p>
            <a class="btn btn-primary" href="files">
                Upload Files
            </a>
        </div>
    </div>

</div>