@using Microsoft.AspNetCore.Components.Authorization
@using SmartX.Client.Services
@inject FirebaseAuthService AuthService
@inject FirebaseAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Smart-X</a>

        <button title="Navigation menu"
                class="navbar-toggler"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">

        <!-- Home remains available as the landing page. -->
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Home
            </NavLink>
        </div>

        <!-- Show the application modules to signed-in users. -->
        <AuthorizeView>
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="bi bi-speedometer2"
                              aria-hidden="true"></span>
                        Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sensors">
                        <span class="bi bi-list-nested-nav-menu"
                              aria-hidden="true"></span>
                        Sensors
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="command-stream">
                        <span class="bi bi-terminal"
                              aria-hidden="true"></span>
                        Command Stream
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="files">
                        <span class="bi bi-file-earmark-arrow-up"
                              aria-hidden="true"></span>
                        Files
                    </NavLink>
                </div>

                <!-- Reserved for the final PoE. -->
                <div class="nav-item px-3">
                    <span class="nav-link text-secondary"
                          aria-disabled="true"
                          title="Available in the final project stage"
                          style="opacity: 0.5; cursor: not-allowed;">
                        <span class="bi bi-diagram-3"
                              aria-hidden="true"></span>
                        Network Topology
                    </span>
                </div>

                <div class="nav-item px-3 mt-3">
                    <button class="nav-link btn btn-link text-start w-100"
                            type="button"
                            disabled="@isLoggingOut"
                            @onclick="LogoutAsync"
                            @onclick:stopPropagation="true">
                        <span class="bi bi-box-arrow-right"
                              aria-hidden="true"></span>
                        @(isLoggingOut ? "Signing out..." : "Sign Out")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="nav-item px-3">
                        <p class="text-danger small">@errorMessage</p>
                    </div>
                }

            </Authorized>

            <NotAuthorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right"
                              aria-hidden="true"></span>
                        Sign In
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-person-plus"
                              aria-hidden="true"></span>
                        Create Account
                    </NavLink>
                </div>

            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool isLoggingOut;
    private string? errorMessage;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Sign out through Firebase and update Blazor's authentication state.
    private async Task LogoutAsync()
    {
        isLoggingOut = true;
        errorMessage = null;

        try
        {
            await AuthService.SignOutAsync();

            await AuthStateProvider.RefreshAuthenticationStateAsync();

            Navigation.NavigateTo("/login");
        }
        catch
        {
            errorMessage = "Unable to sign out. Please try again.";
        }
        finally
        {
            isLoggingOut = false;
        }
    }
}
